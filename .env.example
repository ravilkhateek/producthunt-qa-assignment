# ---------------------------------------------------------------------------
# Template for local configuration. Copy to .env and fill in a real token.
#
#   cp .env.example .env     (macOS / Linux)
#   copy .env.example .env   (Windows)
#
# .env is gitignored; this template is committed so the setup is reproducible.
# ---------------------------------------------------------------------------

# Product Hunt developer token.
# Create an application at https://www.producthunt.com/v2/oauth/applications
# then use the "Create Token" button in its Developer Token section.
# The token does not expire.
PRODUCT_HUNT_TOKEN=your_developer_token_here

# Systems under test.
PH_API_URL=https://api.producthunt.com/v2/api/graphql
PH_WEB_URL=https://www.producthunt.com
