{
  "name": "producthunt-qa",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "QA assignment: test strategy, exploratory findings and automated coverage for Product Hunt",
  "scripts": {
    "token": "bun run scripts/set-token.ts",
    "verify": "bun run scripts/verify-setup.ts",
    "explore": "bun run scripts/explore-api.ts",
    "cost": "bun run scripts/measure-cost.ts",
    "explore:web": "bun run scripts/explore-web.ts",
    "test": "bun run test:api && bun run test:e2e",
    "test:api": "bun test tests/api",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
